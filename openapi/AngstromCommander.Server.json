  "components": {
    "schemas": {
      "ChallengeRequest": {
        "required": [
          "registrationId"
        ],
        "type": "object",
        "properties": {
          "registrationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ChallengeResponse": {
        "required": [
          "nonce"
        ],
        "type": "object",
        "properties": {
          "nonce": {
            "type": "string"
          }
        }
      },
      "ClaimRequest": {
        "required": [
          "code",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "code": {
            "maxLength": 16,
            "minLength": 0,
            "type": "string"
          },
          "displayName": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "ClaimResponse": {
        "required": [
          "registrationId",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "registrationId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "DaemonTokenResponse": {
        "required": [
          "accessToken"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          }
        }
      },
      "DirectoryEntry": {
        "required": [
          "name",
          "isDirectory",
          "sizeBytes",
          "modifiedAt"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "isDirectory": {
            "type": "boolean"
          },
          "sizeBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "modifiedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EnrollmentStatusResponse": {
        "required": [
          "registrationId"
        ],
        "type": "object",
        "properties": {
          "registrationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "required": [
          "accessToken"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          }
        }
      },
      "MachineResponse": {
        "required": [
          "registrationId",
          "displayName",
          "platform",
          "createdAt",
          "lastSeenAt",
          "online"
        ],
        "type": "object",
        "properties": {
          "registrationId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "online": {
            "type": "boolean"
          }
        },
        "description": "One of the caller's paired machines."
      },
      "PairingCodeResponse": {
        "required": [
          "code",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "description": "Credentials for a new account."
      },
      "RegisterResponse": {
        "required": [
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "RequestCodeRequest": {
        "required": [
          "publicKeySpki",
          "platform"
        ],
        "type": "object",
        "properties": {
          "publicKeySpki": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          },
          "platform": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "Stream": {
        "type": "string",
        "format": "binary"
      },
      "TokenRequest": {
        "required": [
          "registrationId",
          "signature"
        ],
        "type": "object",
        "properties": {
          "registrationId": {
            "type": "string",
            "format": "uuid"
          },
          "signature": {
            "maxLength": 512,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "TransferResponse": {
        "required": [
          "bytesTransferred"
        ],
        "type": "object",
        "properties": {
          "bytesTransferred": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        },
        "description": "How many bytes a completed transfer moved."
      }
    }
  },
  "tags": [
    {
      "name": "AngstromCommander.Server"
    }
  ]
}