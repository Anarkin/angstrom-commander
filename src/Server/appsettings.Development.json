{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Registration": {
    "Enabled": true
  },
  "Auth": {
    // Local development only, and it never leaves this file: real environments supply their
    // own key through configuration (env var Auth__JwtSigningKey) and the Server refuses to
    // start without one.
    "JwtSigningKey": "dev-only-signing-key-change-me-0123456789abcdef"
  }
}
